POSTGRES_USER=fastembed
POSTGRES_PASSWORD=fastembed
POSTGRES_DB=fastembed
POSTGRES_PORT=5433
API_PORT=8080

# Modelo nativo FastEmbed, multilíngue (inclui PT), dim 384
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_DIM=384
# Alternativa E5 (melhor retrieval): intfloat/multilingual-e5-small

# Chunking para atas/documentos longos
CHUNK_SIZE=500
CHUNK_OVERLAP=80
