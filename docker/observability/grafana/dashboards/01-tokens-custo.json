{
  "uid": "tedros-ai-tokens",
  "title": "Tedros AI — Tokens & Custo",
  "tags": ["tedros-ai"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "price_per_1k",
        "type": "textbox",
        "label": "Preço por 1k tokens (USD)",
        "query": "0.005",
        "current": { "text": "0.005", "value": "0.005" }
      }
    ]
  },
  "panels": [
    {
      "type": "stat",
      "title": "Tokens/min (total)",
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "expr": "sum(rate(tedros_ai_tokens_total[1m])) * 60", "legendFormat": "tokens/min" }
      ],
      "fieldConfig": { "defaults": { "unit": "short", "decimals": 0 }, "overrides": [] }
    },
    {
      "type": "stat",
      "title": "Custo estimado 24h (USD)",
      "gridPos": { "h": 6, "w": 6, "x": 6, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "expr": "sum(increase(tedros_ai_tokens_total[24h])) / 1000 * $price_per_1k", "legendFormat": "custo" }
      ],
      "fieldConfig": { "defaults": { "unit": "currencyUSD", "decimals": 2 }, "overrides": [] }
    },
    {
      "type": "timeseries",
      "title": "Tokens/min por provider",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "expr": "sum by (provider) (rate(tedros_ai_tokens_total[1m])) * 60", "legendFormat": "{{provider}}" }
      ],
      "fieldConfig": { "defaults": { "unit": "short", "custom": { "drawStyle": "line", "fillOpacity": 10 } }, "overrides": [] }
    },
    {
      "type": "timeseries",
      "title": "Split input/output por provider (increase 1h)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 6 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "expr": "sum by (provider, type) (increase(tedros_ai_tokens_total[1h]))", "legendFormat": "{{provider}} {{type}}" }
      ],
      "fieldConfig": { "defaults": { "unit": "short", "custom": { "drawStyle": "bars", "fillOpacity": 60, "stacking": { "mode": "normal" } } }, "overrides": [] }
    },
    {
      "type": "bargauge",
      "title": "Acumulado 24h por provider",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "expr": "sum by (provider) (increase(tedros_ai_tokens_total[24h]))", "legendFormat": "{{provider}}", "instant": true }
      ],
      "options": { "displayMode": "gradient", "orientation": "horizontal" },
      "fieldConfig": { "defaults": { "unit": "short", "decimals": 0 }, "overrides": [] }
    }
  ]
}
